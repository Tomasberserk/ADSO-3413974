        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n\n%% =========================================================\n%% CASO 2 - SISTEMA DE VENTAS\n%% MODELO ENTIDAD-RELACIÓN - NOTACIÓN CHEN\n%% =========================================================\n\n\n%% =========================================================\n%% PROVEEDOR\n%% =========================================================\n\nPROV[PROVEEDOR]\n\nP_RUT((RUT&lt;br/&gt;PK))\nP_NOMBRE((nombre))\nP_WEB((pagina_web))\nP_TEL((telefono))\n\n%% Dirección compuesta\nP_DIR((DIRECCIÓN&lt;br/&gt;COMPUESTO))\nP_CALLE((calle))\nP_NUMERO((numero))\nP_COMUNA((comuna))\nP_CIUDAD((ciudad))\n\nPROV --- P_RUT\nPROV --- P_NOMBRE\nPROV --- P_WEB\nPROV --- P_TEL\nPROV --- P_DIR\n\nP_DIR --- P_CALLE\nP_DIR --- P_NUMERO\nP_DIR --- P_COMUNA\nP_DIR --- P_CIUDAD\n\n\n%% =========================================================\n%% CLIENTE\n%% =========================================================\n\nCLI[CLIENTE]\n\nC_RUT((RUT&lt;br/&gt;PK))\nC_NOMBRE((nombre))\n\n%% Dirección compuesta\nC_DIR((DIRECCIÓN&lt;br/&gt;COMPUESTO))\nC_CALLE((calle))\nC_NUMERO((numero))\nC_COMUNA((comuna))\nC_CIUDAD((ciudad))\n\n%% Teléfonos multivaluado\nC_TEL(((telefonos&lt;br/&gt;MULTIVALUADO)))\n\nCLI --- C_RUT\nCLI --- C_NOMBRE\nCLI --- C_DIR\nCLI --- C_TEL\n\nC_DIR --- C_CALLE\nC_DIR --- C_NUMERO\nC_DIR --- C_COMUNA\nC_DIR --- C_CIUDAD\n\n\n%% =========================================================\n%% CATEGORÍA\n%% =========================================================\n\nCAT[CATEGORÍA]\n\nCAT_ID((id_categoria&lt;br/&gt;PK))\nCAT_NOMBRE((nombre))\nCAT_DESC((descripcion))\n\nCAT --- CAT_ID\nCAT --- CAT_NOMBRE\nCAT --- CAT_DESC\n\n\n%% =========================================================\n%% PRODUCTO\n%% =========================================================\n\nPROD[PRODUCTO]\n\nPROD_ID((id_producto&lt;br/&gt;PK))\nPROD_NOMBRE((nombre))\nPROD_PRECIO((precio_actual))\nPROD_STOCK((stock))\n\nPROD --- PROD_ID\nPROD --- PROD_NOMBRE\nPROD --- PROD_PRECIO\nPROD --- PROD_STOCK\n\n\n%% =========================================================\n%% VENTA\n%% =========================================================\n\nVENTA[VENTA]\n\nV_ID((id_venta&lt;br/&gt;PK))\nV_FECHA((fecha))\nV_DESC((descuento))\nV_MONTO((monto_final))\n\nVENTA --- V_ID\nVENTA --- V_FECHA\nVENTA --- V_DESC\nVENTA --- V_MONTO\n\n\n%% =========================================================\n%% DETALLE DE VENTA\n%% =========================================================\n\nDET[DETALLE DE VENTA]\n\nD_PRECIO((precio_momento_venta&lt;br/&gt;HISTÓRICO))\nD_CANT((cantidad_vendida))\n\n%% Atributo calculado / derivado\nD_TOTAL(((monto_total_producto&lt;br/&gt;CALCULADO&lt;br/&gt;precio × cantidad)))\n\nDET --- D_PRECIO\nDET --- D_CANT\nDET --- D_TOTAL\n\n\n%% =========================================================\n%% RELACIÓN PROVEEDOR - PRODUCTO\n%% =========================================================\n\nR_PROV{SUMINISTRA}\n\nPROV --&gt;|1| R_PROV\nR_PROV --&gt;|N| PROD\n\n\n%% =========================================================\n%% RELACIÓN CATEGORÍA - PRODUCTO\n%% =========================================================\n\nR_CAT{AGRUPA}\n\nCAT --&gt;|1| R_CAT\nR_CAT --&gt;|N| PROD\n\n\n%% =========================================================\n%% RELACIÓN CLIENTE - VENTA\n%% =========================================================\n\nR_CLI{REALIZA}\n\nCLI --&gt;|1| R_CLI\nR_CLI --&gt;|N| VENTA\n\n\n%% =========================================================\n%% RELACIÓN VENTA - DETALLE\n%% =========================================================\n\nR_VENTA{CONTIENE}\n\nVENTA --&gt;|1| R_VENTA\nR_VENTA --&gt;|N| DET\n\n\n%% =========================================================\n%% RELACIÓN DETALLE - PRODUCTO\n%% =========================================================\n\nR_PROD{CORRESPONDE A}\n\nDET --&gt;|N| R_PROD\nR_PROD --&gt;|1| PROD&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="oBVFhTHP1BII05huzkJH-1">
